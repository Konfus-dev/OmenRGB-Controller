# The only part of RGB Hub that runs as root. Started on demand by
# rgbhub-ram.socket. See helper/rgbhub_ram_helper.py for what it may do.
[Unit]
Description=RGB Hub RAM helper (sets RAM lighting through the BIOS)

[Service]
# A root-owned copy, so the root service never runs code a user can edit.
ExecStart=/usr/bin/python3 -I /usr/local/lib/rgbhub/rgbhub_ram_helper.py
Restart=on-failure
# It needs /proc/acpi/call and nothing else.
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
MemoryMax=32M
