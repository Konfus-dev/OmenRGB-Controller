[Unit]
Description=OMEN Lights service (cooler LCD and case lights)
After=openrgb-server.service
Wants=openrgb-server.service
# When OpenRGB is restarted, stop first and start after it. While we hold a
# connection, OpenRGB cannot reopen its port and fails for minutes.
PartOf=openrgb-server.service

[Service]
# Rebuild the compiled settings list first, so a newly pulled version with
# new settings never starts against an old list.
ExecStartPre=/usr/bin/glib-compile-schemas %h/.local/share/gnome-shell/extensions/omenrgb@konfus-dev.github.io/schemas
ExecStart=%h/.local/share/omenrgb/venv/bin/python -m omenrgb
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
