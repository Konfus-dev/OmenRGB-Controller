# The only part of OMEN Lights that runs as root. Started on demand by
# omenrgb-ram.socket. See helper/omenrgb_ram_helper.py for what it may do.
[Unit]
Description=OMEN Lights RAM helper (sets RAM lighting through the BIOS)

[Service]
# A root-owned copy, so the root service never runs code a user can edit.
ExecStart=/usr/bin/python3 -I /usr/local/lib/omenrgb/omenrgb_ram_helper.py
Restart=on-failure
# It needs /proc/acpi/call and nothing else.
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallFilter=@system-service
MemoryMax=32M
# Do NOT add ProtectKernelTunables= or ProcSubset=pid here: both make
# /proc/acpi/call, the one file this helper needs, unusable.
