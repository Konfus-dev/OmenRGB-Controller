# SPDX-License-Identifier: GPL-3.0-or-later
# Installed by install/setup.sh, which replaces @USER@ with your user name.
[Unit]
Description=RGB Hub RAM helper socket

[Socket]
ListenStream=/run/rgbhub-ram.sock
# Only this user may talk to the root helper.
SocketUser=@USER@
SocketMode=0600

[Install]
WantedBy=sockets.target
