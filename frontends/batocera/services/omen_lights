#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# OMEN Lights for Batocera. Shows up as a switch under
#   Main menu > System Settings > Services
# and makes the cooler LCD and case lights follow the game being played.
#
# Batocera calls this with "start" or "stop".

app=/userdata/system/omen-lights
pidfile=/var/run/omen-lights.pid
log=/userdata/system/logs/omen-lights.log

case "$1" in
    start)
        [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null && exit 0
        mkdir -p "$(dirname "$log")"
        : >"$log"  # start a fresh log; everything below adds to it
        # The RAM lights need this kernel module; without it they are skipped.
        # (The module only fits the kernel version it was built for.)
        [ -e /proc/acpi/call ] || modprobe acpi_call 2>/dev/null ||
            insmod "$app/modules/$(uname -r)/acpi_call.ko" 2>>"$log" || true
        PYTHONPATH="$app/service" nohup python3 -m omenrgb --platform batocera --verbose \
            >>"$log" 2>&1 &
        echo $! >"$pidfile"
        ;;
    stop)
        [ -f "$pidfile" ] && kill "$(cat "$pidfile")" 2>/dev/null
        rm -f "$pidfile"
        ;;
esac
